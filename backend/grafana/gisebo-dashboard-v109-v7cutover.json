     "query": "data = from(bucket: \"home_assistant\")\r\n  |> range(start: 2026-01-01T00:00:00Z, stop: 2026-12-31T23:59:59Z)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"http_listener_v2\")\r\n  |> filter(fn: (r) => r[\"_field\"] == \"temperature\")\r\n  |> filter(fn: (r) => r[\"device_id\"] == \"gisebo-01\" or (r[\"device_id\"] == \"gisebo-05\" and r[\"_time\"] >= 2026-08-02T16:26:00Z))\n  |> filter(fn: (r) => r[\"_value\"] >= -2.0)\r\n  |> filter(fn: (r) => r[\"host\"] != \"3027a048eee2\")\r\n  |> drop(columns: [\"host\", \"device_id\"])\r\n\r\n// Calculate each aggregation separately\r\nmin_data = data |> aggregateWindow(every: 1w, fn: min) |> set(key: \"_field\", value: \"raw_min\")\r\nmed_data = data |> aggregateWindow(every: 1w, fn: median) |> set(key: \"_field\", value: \"raw_med\")\r\nmax_data = data |> aggregateWindow(every: 1w, fn: max) |> set(key: \"_field\", value: \"raw_max\")\r\n\r\n// Align by time and calculate the stacked segments\r\naligned = union(tables: [min_data, med_data, max_data])\r\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\r\n  |> map(fn: (r) => ({\r\n    _time: r._time,\r\n    min_seg: r.raw_min,\r\n    med_seg: r.raw_med - r.raw_min,\r\n    max_seg: r.raw_max - r.raw_med\r\n  }))\r\n\r\n// Output as three distinct time series\r\nunion(tables: [\r\n  aligned |> map(fn: (r) => ({ _time: r._time, _field: \"1_Min\", _value: r.min_seg })),\r\n  aligned |> map(fn: (r) => ({ _time: r._time, _field: \"2_Median\", _value: r.med_seg })),\r\n  aligned |> map(fn: (r) => ({ _time: r._time, _field: \"3_Max\", _value: r.max_seg }))\r\n])\r\n  |> group(columns: [\"_field\"]) // This is the crucial step to restore the timeline\r\n  |> yield(name: \"weekly_temperature_stack\")",
